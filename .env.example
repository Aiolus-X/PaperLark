PORT=8787
HOST=127.0.0.1
PAPERLARK_MODE=live

# Optional OpenAI-compatible model endpoint.
LLM_API_KEY=
LLM_API_KEY_FILE=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-id
LLM_API=responses
LLM_REASONING_EFFORT=xhigh
LLM_TIMEOUT_MS=180000
LLM_DOCUMENT_TIMEOUT_MS=600000
LLM_STREAM=true

# Optional Feishu custom app credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TRANSPORT=websocket
FEISHU_WATCH_FILES=
FEISHU_POLL_INTERVAL_MS=15000
FEISHU_TEMPLATE_URL=
FEISHU_SUMMARY_FOLDER_URL=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

PAPERLARK_BRIDGE_CONFIG=data/browser-bridge.json
PAPERLARK_SELECTION_WAIT_MS=120000

# Personal model settings, encrypted and ignored by Git.
PAPERLARK_MODEL_SETTINGS=data/model-settings.json
PAPERLARK_MODEL_KEY_FILE=data/model-settings.key
# Optional: a Base64-encoded 32-byte encryption key instead of a generated local file.
PAPERLARK_ENCRYPTION_KEY=
# Exact API hostnames accepted by the settings page. Add your own provider if needed.
PAPERLARK_LLM_ALLOWED_HOSTS=api.openai.com,suwen.chatfold.pro
